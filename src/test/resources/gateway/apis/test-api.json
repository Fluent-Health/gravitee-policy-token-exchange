{
  "id": "test-api",
  "name": "Test API",
  "version": "1.0",
  "gravitee": "2.0.0",
  "proxy": {
    "context_path": "/test",
    "endpoints": [
      {
        "name": "default",
        "target": "http://wiremock:8080/backend",
        "http": {
          "connectTimeout": 5000,
          "readTimeout": 10000
        }
      }
    ]
  },
  "flows": [
    {
      "name": "Flow",
      "methods": [],
      "condition": "",
      "pre": [
        {
          "name": "OAuth2 Token Orchestrator",
          "policy": "oauth2-token-orchestrator",
          "configuration": {
            "cacheResource": "cache",
            "tokenEndpoint": "http://wiremock:8080/token",
            "grantType": "token_exchange",
            "cacheKey": "static-key"
          }
        }
      ],
      "post": []
    }
  ],
  "resources": [
    {
      "name": "cache",
      "type": "cache",
      "configuration": {
        "timeToIdleSeconds": 0,
        "timeToLiveSeconds": 3600,
        "maxEntriesLocalHeap": 1000
      }
    }
  ]
}
